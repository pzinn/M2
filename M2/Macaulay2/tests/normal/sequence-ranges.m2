assert( ((1,2) .. (2,4)) === ((1,2),(1,3),(1,4),(2,2),(2,3),(2,4)) )
assert( ((1,2) ..< (3,5)) === ((1,2),(1,3),(1,4),(2,2),(2,3),(2,4)) )
assert( (() .. ()) === 1 : (()) )
assert( ((3,1) .. (2,2)) === () )
assert( try ((1,2) .. (1,2,3); false) else true )

assert( ({1,2} .. {2,3}) === ({1,2},{1,3},{2,2},{2,3}) )
assert( ({1,2} ..< {3,4}) === ({1,2},{1,3},{2,2},{2,3}) )
assert( ("a" .. "c") === ("a","b","c") )
assert( ("a" ..< "d") === ("a","b","c") )
